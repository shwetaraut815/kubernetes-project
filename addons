### use shell script Updating Kubernetes deployment YAMLs with new image tags

#!/bin/bash

IMAGE_NAME="myrepo/myapp"
NEW_TAG=$1

sed -i "s|$IMAGE_NAME:.*|$IMAGE_NAME:$NEW_TAG|g" deployment.yaml

## also we can use 

kubectl set image deployment/myapp myapp=myrepo/myapp:$BUILD_NUMBER

## shell script for Building and tagging Docker images dynamically using build numbers

#!/bin/bash

IMAGE_NAME="myrepo/myapp"
BUILD_NUMBER=$1

docker build -t $IMAGE_NAME:$BUILD_NUMBER .

