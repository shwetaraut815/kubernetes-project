## take backup of jenkins home

#!/bin/bash

JENKINS_HOME="/var/lib/jenkins"
BACKUP_DIR="/backup/jenkins"

DATE=$(date +%F)

tar -czf $BACKUP_DIR/jenkins-backup-$DATE.tar.gz $JENKINS_HOME

echo "Jenkins backup completed on $DATE"



